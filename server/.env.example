PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ── Voice Engine Mode (browser | sarvam-static | sarvam) ──────────────
# browser: Free. Client handles SpeechRecognition & SpeechSynthesis. Zero Sarvam audio calls.
# sarvam-static: Pre-generated Sarvam audio for fixed prompts; browser voice for dynamic readback.
# sarvam: Live Sarvam STT & TTS (with local disk-caching).
VOICE_MODE=browser

# ── Sarvam AI (Exclusively used for LLM, STT, and TTS) ─────────────
# Base URL: https://api.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Female Indian English voice: ritu (default), priya, kavya, neha, shreya, roopa
# Male Indian English voice: shubh, aditya, rahul, rohan, dev, amit
SARVAM_TTS_VOICE=ritu

# ── Clinic Hours (for time-slot validation) ───────────────────────
# Hours in 24h format. Times outside this range will be rejected.
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=19

# ── Firebase Admin SDK Credentials ───────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ── Google Calendar OAuth Credentials ────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
